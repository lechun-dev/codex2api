# Copy to /opt/codex2api/shared/.env and chmod 600.
CODEX2API_IMAGE=ghcr.io/james-6-23/codex2api:v2.8.2
CODEX_PORT=8080
BIND_HOST=127.0.0.1
TZ=Asia/Shanghai
DATABASE_DRIVER=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=codex2api
DATABASE_PASSWORD=replace-with-a-long-random-password
DATABASE_NAME=codex2api
DATABASE_SSLMODE=disable
CACHE_DRIVER=redis
REDIS_ADDR=redis:6379
REDIS_DB=0
REDIS_TLS=false
REDIS_INSECURE_SKIP_VERIFY=false
ADMIN_SECRET=replace-with-a-long-random-secret
CODEX_API_KEYS=
# Optional HTTP(S)/SOCKS5 proxy (keep credentials out of Git):
# CODEX_PROXY_URL=socks5://user:password@host.docker.internal:1080
CODEX_USAGE_LOG_CAPTURE_REQUEST_CONTENT=false
CODEX_CONVERSATION_RECORDING_ENABLED=true
CODEX_DOWNLOADS_DIR=/data/downloads
